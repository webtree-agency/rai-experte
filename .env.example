# ─── Payload ────────────────────────────────────────────────────────────
PAYLOAD_SECRET=bitte-in-produktion-aendern-mindestens-32-zeichen
DATABASE_URI=postgres://payload:payload@localhost:5432/rai_experte

# ─── R2 Media-Storage (Cloudflare R2, S3-kompatibel) ────────────────────
# Shared-Bucket webtree-media mit Projekt-Prefix `rai-experte` (NICHT sportara-ag!).
# Bilder werden öffentlich über media.webtree.ch/rai-experte/... ausgeliefert.
S3_BUCKET=webtree-media
S3_ENDPOINT=https://256f2599fd4fde46bb7b18d7b1ad75ae.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.webtree.ch
S3_PREFIX=rai-experte

# ─── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Resend (Kontakt + Event-Anmeldungen) ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@rai-experte.ch
EMAIL_TO=rai-experte@gmx.ch
# Öffentliche Logo-URL für den Mail-Kopf (z. B. media.webtree.ch/...).
# Lokal nötig, weil localhost-Bilder im Mail-Client nicht laden.
EMAIL_LOGO_URL=

# ─── Docker / Postgres (optional, für docker-compose) ───────────────────
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=rai_experte
